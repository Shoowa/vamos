{
  "log_requests_level": "trace",
  "log_level": "trace",
  "ui": false,

  "api_addr":     "https://0.0.0.0:8233",

  "listener": [
    {
      "tcp": {
        "address":       "0.0.0.0:8233",
        "tls_cert_file": "/pki/public/openbao.pem",
        "tls_key_file":  "/pki/private/openbao-key.pem",
        "tls_require_and_verify_client_cert": "true",
        "tls_client_ca_file": "/pki/root/ca.pem",
        "tls_min_version": "tls13",
      }
    }
  ],

  "initialize": [
    {
      "prepare-dev-env": {
        "request": [
          {
            "enable-transit-engine": {
              "operation": "create",
              "path": "sys/mounts/transit",
              "token": "token",
              "data": {
                "type": "transit",
                "description": "hashesAndTokens",
                "local": true,
                "seal_wrap": false,
                "external_entropy_access": false,
                "config": {
                  "default_lease_ttl": "0s",
                  "max_lease_ttl": "0s",
                  "force_no_cache": false
                }
              }
            }
          },
          {
            "enable-pki-engine-for-root-cert-auth": {
              "operation": "create",
              "path": "sys/mounts/pki",
              "token": "token",
              "data": {
                "type": "pki",
                "description": "public key infrastructure",
                "config": {
                  "max_lease_ttl": "438000h"
                }
              }
            }
          },
          {
            "generate-self-signed-root-cert": {
              "operation": "create",
              "path": "pki/root/generate/internal",
              "token": "token",
              "data": {
                "common_name": "Vamos",
                "issuer_name": "root26",
                "key_type": "rsa",
                "key_bits": 4096,
                "ttl": "26280h"
              }
            }
          },
          {
            "configure-PKI-URLs": {
              "operation": "create",
              "path": "pki/config/urls",
              "token": "token",
              "data": {
                "issuing_certificates": "http://localhost:8200/v1/pki/root/ca",
                "crl_distribution_points": "http://localhost:8200/v1/pki/root/crl"
              }
            }
          },
          {
            "configure-role-for-PKI": {
              "operation": "create",
              "path": "pki/roles/dev",
              "token": "token",
              "data": {
                "allowed_domains": "openbao,postgres,redis,app",
                "allow_subdomains": true,
                "allow_bare_domains": true,
                "enforce_hostnames": true,
                "allow_localhost": true,
                "require_cn": true,
                "max_ttl": "96h"
              }
            }
          },
          {
            "add-postgres-password": {
              "operation": "create",
              "path": "secret/data/dev-postgres-test",
              "token": "token",
              "data": {
                "data": {
                  "password": "password"
                }
              }
            }
          },
          {
            "add-redis-password": {
              "operation": "create",
              "path": "secret/data/dev-redis-test",
              "token": "token",
              "data": {
                "data": {
                  "password": "redis4life"
                }
              }
            }
          }
        ]
      }
    }
  ]
}
